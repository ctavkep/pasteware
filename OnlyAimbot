    valLbl.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("Frame", container)
    track.Size             = UDim2.new(1, -28, 0, 4)
    track.Position         = UDim2.new(0, 14, 0, 36)
    track.BackgroundColor3 = C.SliderOff
    track.BorderSizePixel  = 0
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local ratio = math.clamp((default - minVal) / (maxVal - minVal), 0, 1)

    local fill = Instance.new("Frame", track)
    fill.Size             = UDim2.new(ratio, 0, 1, 0)
    fill.BackgroundColor3 = C.Accent
    fill.BorderSizePixel  = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local fGrad = Instance.new("UIGradient", fill)
    fGrad.Color = ColorSequence.new(C.Accent, C.Violet)

    local dot = Instance.new("Frame", track)
    dot.Size             = UDim2.new(0, 12, 0, 12)
    dot.AnchorPoint      = Vector2.new(0.5, 0.5)
    dot.Position         = UDim2.new(ratio, 0, 0.5, 0)
    dot.BackgroundColor3 = C.White
    dot.BorderSizePixel  = 0
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
    local dotStroke = Instance.new("UIStroke", dot)
    dotStroke.Color     = C.Accent
    dotStroke.Thickness = 1.5

    local hitbox = Instance.new("TextButton", container)
    hitbox.Size             = UDim2.new(1, -28, 0, 22)
    hitbox.Position         = UDim2.new(0, 14, 0, 26)
    hitbox.BackgroundTransparency = 1
    hitbox.Text             = ""

    local dragging = false
    local function applyVal(sx)
        local rel = math.clamp((sx - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val
        if (maxVal - minVal) > 10 then
            val = math.floor(minVal + (maxVal - minVal) * rel)
        else
            val = math.floor((minVal + (maxVal - minVal) * rel) * 10) / 10
        end
        fill.Size     = UDim2.new(rel, 0, 1, 0)
        dot.Position  = UDim2.new(rel, 0, 0.5, 0)
        valLbl.Text   = tostring(val)
        safe(callback, val)
    end

    hitbox.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            Settings.IsDraggingSlider = true
            applyVal(inp.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            applyVal(inp.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
            dragging = false
            Settings.IsDraggingSlider = false
        end
    end)

    return container
end

