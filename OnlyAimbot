local function safe(fn, ...)
    local ok, err = pcall(fn, ...)
    return ok, err
end

local function GetAimLookTarget(targetPos)
    if Settings.TP_Enabled then
        local char = LocalPlayer.Character
        local head = char and char:FindFirstChild("Head")
        if head then
            local dir = (targetPos - head.Position).Unit
            return Camera.CFrame.Position + dir * 2000
        end
    end
    return targetPos
end

local function IsVisible(part, targetCharacter)
    if not Settings.AimbotWallCheck then return true end
    local character = LocalPlayer.Character
    if not character then return false end
    local head = character:FindFirstChild("Head")
    if not head then return false end
    if not part or not part.Parent then return false end

    local camOrigin  = Camera.CFrame.Position
    local charOrigin = head.Position
    local targetPos  = part.Position

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character, targetCharacter, Camera}
    params.IgnoreWater = true

    local okCam,  resCam  = pcall(workspace.Raycast, workspace, camOrigin,  targetPos - camOrigin,  params)
    local okChar, resChar = pcall(workspace.Raycast, workspace, charOrigin, targetPos - charOrigin, params)

    if not okCam  then resCam  = true end
    if not okChar then resChar = true end

    if Settings.FixAim then
        return (resCam == nil) and (resChar == nil)
    else
        return resCam == nil
    end
end

local function getBestPart(character)
    if not character then return nil end
    local partName = Settings.TARGET_PART
    if partName ~= "All" then
        if partName == "Random" then
            partName = PriorityParts[math.random(1, 3)]
        end
        local p = character:FindFirstChild(partName)
        if p and p.Parent and IsVisible(p, character) then return p end
        return nil
    end
    for _, name in ipairs(PriorityParts) do
        local p = character:FindFirstChild(name)
        if p and p.Parent and IsVisible(p, character) then return p end
    end
    return nil
end

local function GetESPData(player)
    if not ESP_CACHE[player] then
        local ok, result = pcall(function()
            return { Name = Drawing.new("Text"), Health = Drawing.new("Text") }
        end)
        if ok then ESP_CACHE[player] = result else return nil end
    end
    return ESP_CACHE[player]
end

local function RemoveESP(player)
    if ESP_CACHE[player] then
        safe(function()
            if ESP_CACHE[player].Name   then ESP_CACHE[player].Name:Remove()   end
            if ESP_CACHE[player].Health then ESP_CACHE[player].Health:Remove()  end
        end)
        ESP_CACHE[player] = nil
    end
end
Players.PlayerRemoving:Connect(RemoveESP)

local function UpdateESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        safe(function()
            local char = p.Character
            local head = char and char:FindFirstChild("Head")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            local data = GetESPData(p)
            if not data then return end

            local visible = Settings.ESPEnabled and head and hum and hum.Health > 0

            if visible then
                local isTeam = (p.Team == LocalPlayer.Team)
                if Settings.ESPTeamCheck and isTeam then
                    data.Name.Visible = false
                    data.Health.Visible = false
                    local hl = char:FindFirstChild("OBKAK_Highlight")
                    if hl then hl.Enabled = false end
                    return
                end

                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                local dist = (Camera.CFrame.Position - head.Position).Magnitude

                if onScreen and dist <= Settings.MaxDistance then
                    local color = isTeam and Color3.new(0,1,0) or Color3.new(1,0,0)
                    if Settings.ShowNames then
                        data.Name.Text     = p.Name
                        data.Name.Position = Vector2.new(pos.X, pos.Y - 30)
                        data.Name.Color    = color
                        data.Name.Visible  = true
                        data.Name.Outline  = true
                        data.Name.Size     = 14
                    else
                        data.Name.Visible = false
                    end
                    if Settings.ShowHealth then
                        data.Health.Text     = "HP: " .. math.floor(hum.Health)
                        data.Health.Position = Vector2.new(pos.X, pos.Y - 15)
                        data.Health.Color    = Color3.new(1,1,1)
                        data.Health.Visible  = true
                        data.Health.Outline  = true
                        data.Health.Size     = 13
                    else
                        data.Health.Visible = false
                    end
                    if Settings.ShowChams then
                        local h = char:FindFirstChild("OBKAK_Highlight")
                        if not h then
                            h = Instance.new("Highlight")
                            h.Name = "OBKAK_Highlight"
                            h.Parent = char
                        end
                        h.Enabled          = true
                        h.FillColor        = color
                        h.FillTransparency = Settings.ChamsTransparency
                    else
                        local hl = char:FindFirstChild("OBKAK_Highlight")
                        if hl then hl.Enabled = false end
                    end
                else
                    data.Name.Visible   = false
                    data.Health.Visible = false
                    local hl = char:FindFirstChild("OBKAK_Highlight")
                    if hl then hl.Enabled = false end
                end
            else
                data.Name.Visible   = false
                data.Health.Visible = false
                if char then
                    local hl = char:FindFirstChild("OBKAK_Highlight")
                    if hl then hl.Enabled = false end
                end
            end
        end)
    end
end

