-- Auto Clicker/Triggerbot script implementation
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local localPlayer = Players.LocalPlayer
local mouse = localPlayer:GetMouse()

-- Settings with Team Check
local AUTOCLICKER_SETTINGS = {
    Enabled = false,
    TriggerDelay = 0.01,
    MaxDistance = 50,
    TeamCheck = true -- Added team check
}

-- Simple virtual click function
local function virtual_click()
    VirtualInputManager:SendMouseButtonEvent(
        mouse.X, 
        mouse.Y, 
        0,
        true,
        game, 
        false
    )
    
    task.wait(0.01)
    
    VirtualInputManager:SendMouseButtonEvent(
        mouse.X, 
        mouse.Y, 
        0,
        false,
        game, 
        false
    )
end

-- Function to check if target is enemy
local function isEnemy(player)
    if not AUTOCLICKER_SETTINGS.TeamCheck then
        return true -- If team check is disabled, shoot everyone
    end
    
    -- Check if both players have teams
    if localPlayer.Team and player.Team then
        return localPlayer.Team ~= player.Team
    end
    
    -- If no teams, consider as enemy
    return true
end

-- Main function with team check
local function autoClicker()
    while true do
        if not AUTOCLICKER_SETTINGS.Enabled then
            wait(0.1)
            continue
        end
        
        wait(AUTOCLICKER_SETTINGS.TriggerDelay)
        
        -- Check target under cursor
        local target = mouse.Target
        if not target then continue end

        -- Find player model
        local model = target:FindFirstAncestorOfClass("Model")
        if not model then continue end

        -- Check if it's a player
        local player = Players:GetPlayerFromCharacter(model)
        if not player or player == localPlayer then continue end
        
        -- Team check
        if not isEnemy(player) then continue end

        -- Check distance
        local character = localPlayer.Character
        if not character then continue end
        
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        local targetRoot = model:FindFirstChild("HumanoidRootPart")
        
        if not humanoidRootPart or not targetRoot then continue end
        
        local distance = (humanoidRootPart.Position - targetRoot.Position).Magnitude
        if distance > AUTOCLICKER_SETTINGS.MaxDistance then continue end

        -- Simulate left mouse click
        virtual_click()
    end
end

-- Start the auto clicker
task.spawn(autoClicker)

