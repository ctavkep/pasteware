                    if loopConnection then loopConnection:Disconnect() end
                    
                    local lastGhostUpdate = os.clock()
                    local lastPosition = nil
                    
                    loopConnection = rs.Heartbeat:Connect(function()
                        if not loopEnabled or not desyncon then return end
                        
                        local char = plrs.LocalPlayer.Character
                        if char and char:FindFirstChild("HumanoidRootPart") then
                            local currentPos = char.HumanoidRootPart.CFrame
                            local currentTime = os.clock()
                            
                            lastPosition = currentPos
                            
                            if currentTime - lastGhostUpdate >= loopInterval then
                                if lastPosition then
                                    moveGhost(lastPosition)
                                    orbpos = lastPosition
                                end
                                
                                pcall(function() setfflag("NextGenReplicatorEnabledWrite4", "false") end)
                                task.wait(0.05)
                                pcall(function() setfflag("NextGenReplicatorEnabledWrite4", "true") end)
                                
                                lastGhostUpdate = currentTime
                            end
                        end
                    end)
                else
                    if loopConnection then 
                        loopConnection:Disconnect()
                        loopConnection = nil
                    end
                    
                    loopsyncbtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
                    loopsyncbtn.Text = "LOOP DESYNC: OFF"
