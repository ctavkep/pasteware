-- ESP Functions
local function checkPlayerState(player)
    if not player then return false end
    local character = player.Character
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    return humanoid.Health > 0
end

local function createBodyPart(partType, size, color)
    local part
    if partType == "head" then
        part = Instance.new("SphereHandleAdornment")
        part.Radius = size / 2
    else
        part = Instance.new("BoxHandleAdornment")
        part.Size = size
    end
    part.Name = "ESPPart"
    part.AlwaysOnTop = true
    part.ZIndex = 2
    part.Transparency = ESP_SETTINGS.BodyTransparency
    part.Color3 = color
    part.Adornee = nil
    return part
end

local function createESP(player)
    if espCache[player] then 
        cleanUpESP(player)
    end
    
    local esp = {
        elements = {},
        isAlive = true,
        timeOfDeath = nil,
        pulseTime = 0
    }
    
    -- Body parts
    local bodyParts = {}
    
    if ESP_SETTINGS.ShowBody then
        -- Head
        local head = createBodyPart("head", 2, ESP_SETTINGS.PrimaryColor)
        table.insert(bodyParts, head)
        
        -- Torso
        local torso = createBodyPart("box", Vector3.new(2, 3, 1), ESP_SETTINGS.PrimaryColor)
        table.insert(bodyParts, torso)
        
        -- Arms
        local leftArm = createBodyPart("box", Vector3.new(1, 2.5, 1), ESP_SETTINGS.PrimaryColor)
        local rightArm = createBodyPart("box", Vector3.new(1, 2.5, 1), ESP_SETTINGS.PrimaryColor)
        table.insert(bodyParts, leftArm)
        table.insert(bodyParts, rightArm)
        
        -- Legs
        local leftLeg = createBodyPart("box", Vector3.new(1, 2.5, 1), ESP_SETTINGS.PrimaryColor)
        local rightLeg = createBodyPart("box", Vector3.new(1, 2.5, 1), ESP_SETTINGS.PrimaryColor)
        table.insert(bodyParts, leftLeg)
        table.insert(bodyParts, rightLeg)
    end
    
    -- Text billboard
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESPBillboard"
    billboard.Size = UDim2.new(0, 200, 0, 80)
    billboard.StudsOffset = Vector3.new(0, 5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 500
    billboard.Adornee = nil
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "ESPText"
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = ""
    textLabel.TextColor3 = Color3.new(1, 1, 1)
    textLabel.TextStrokeColor3 = ESP_SETTINGS.PrimaryColor
    textLabel.TextStrokeTransparency = 0.3
    textLabel.TextSize = ESP_SETTINGS.TextSize
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextYAlignment = Enum.TextYAlignment.Top
    textLabel.Parent = billboard
    
    -- Tracer
    local tracer = Instance.new("Beam")
    tracer.Name = "ESPTracer"
    tracer.Width0 = 0.05
    tracer.Width1 = 0.05
    tracer.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, ESP_SETTINGS.PrimaryColor),
        ColorSequenceKeypoint.new(1, ESP_SETTINGS.TracerColor)
    })
    tracer.Transparency = NumberSequence.new(ESP_SETTINGS.TracerTransparency)
    tracer.Enabled = false
    
    local attachment0 = Instance.new("Attachment")
    local attachment1 = Instance.new("Attachment")
    tracer.Attachment0 = attachment0
    tracer.Attachment1 = attachment1
    
    esp.elements = {
        bodyParts = bodyParts,
        billboard = billboard,
        textLabel = textLabel,
        tracer = tracer,
        attachment0 = attachment0,
        attachment1 = attachment1
    }
    
    -- Parent to CoreGui
    local coreGui = game:GetService("CoreGui")
    for _, part in pairs(bodyParts) do
        part.Parent = coreGui
    end
    billboard.Parent = coreGui
    
    espCache[player] = esp
    return esp
end

local function updateBodyParts(esp, character)
    if not ESP_SETTINGS.ShowBody then
        for _, part in ipairs(esp.elements.bodyParts) do
            part.Adornee = nil
        end
        return
    end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local headPart = character:FindFirstChild("Head")
    local torsoPart = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    local leftArmPart = character:FindFirstChild("LeftUpperArm") or character:FindFirstChild("Left Arm")
    local rightArmPart = character:FindFirstChild("RightUpperArm") or character:FindFirstChild("Right Arm")
    local leftLegPart = character:FindFirstChild("LeftUpperLeg") or character:FindFirstChild("Left Leg")
    local rightLegPart = character:FindFirstChild("RightUpperLeg") or character:FindFirstChild("Right Leg")
    
    -- Attach parts to corresponding bones
    if esp.elements.bodyParts[1] and headPart then
        esp.elements.bodyParts[1].Adornee = headPart
    end
    if esp.elements.bodyParts[2] and torsoPart then
        esp.elements.bodyParts[2].Adornee = torsoPart
    end
    if esp.elements.bodyParts[3] and leftArmPart then
        esp.elements.bodyParts[3].Adornee = leftArmPart
    end
    if esp.elements.bodyParts[4] and rightArmPart then
        esp.elements.bodyParts[4].Adornee = rightArmPart
    end
    if esp.elements.bodyParts[5] and leftLegPart then
        esp.elements.bodyParts[5].Adornee = leftLegPart
    end
    if esp.elements.bodyParts[6] and rightLegPart then
        esp.elements.bodyParts[6].Adornee = rightLegPart
    end
end

local function updatePulseEffect(esp, dt)
    esp.pulseTime = esp.pulseTime + dt * 3
    
    local pulse = (math.sin(esp.pulseTime) + 1) * 0.5
    
    for _, part in ipairs(esp.elements.bodyParts) do
        if part then
            part.Transparency = ESP_SETTINGS.BodyTransparency - pulse * 0.2
        end
    end
end

local function updateESP(player, esp, dt)
    if not espEnabled then return end
    
    local character = player.Character
    if not character then
        for _, part in ipairs(esp.elements.bodyParts) do
            part.Adornee = nil
        end
        esp.elements.billboard.Adornee = nil
        esp.elements.tracer.Enabled = false
        return
    end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then
        for _, part in ipairs(esp.elements.bodyParts) do
            part.Adornee = nil
        end
        esp.elements.billboard.Adornee = nil
        esp.elements.tracer.Enabled = false
        return
    end
    
    local isAlive = checkPlayerState(player)
    
    -- Handle player death
    if not isAlive and esp.isAlive then
        esp.timeOfDeath = tick()
    elseif isAlive and not esp.isAlive then
        esp.timeOfDeath = nil
    end
    
    esp.isAlive = isAlive
    
    -- Check timeout for dead players
    if not isAlive and esp.timeOfDeath then
        local timeSinceDeath = tick() - esp.timeOfDeath
        if timeSinceDeath >= ESP_SETTINGS.DeadESPTimeout then
            cleanUpESP(player)
            return
        end
    end
    
    -- Update body part positions
    updateBodyParts(esp, character)
    
    -- Update text position
    if ESP_SETTINGS.ShowText then
        esp.elements.billboard.Adornee = humanoidRootPart
        esp.elements.billboard.Enabled = true
    else
        esp.elements.billboard.Adornee = nil
        esp.elements.billboard.Enabled = false
    end
    
    -- Update colors and transparency
    for _, part in ipairs(esp.elements.bodyParts) do
        part.Color3 = ESP_SETTINGS.PrimaryColor
        part.Transparency = ESP_SETTINGS.BodyTransparency
    end
    
    esp.elements.textLabel.TextStrokeColor3 = ESP_SETTINGS.PrimaryColor
    esp.elements.textLabel.TextSize = ESP_SETTINGS.TextSize
    
    esp.elements.tracer.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, ESP_SETTINGS.PrimaryColor),
        ColorSequenceKeypoint.new(1, ESP_SETTINGS.TracerColor)
    })
    esp.elements.tracer.Transparency = NumberSequence.new(ESP_SETTINGS.TracerTransparency)
    
    -- Calculate distance
    local localCharacter = LocalPlayer.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
    local distance = 0
    
    if localRoot then
        distance = (humanoidRootPart.Position - localRoot.Position).Magnitude
    end
    
    -- Update text
    if ESP_SETTINGS.ShowText then
        local status = isAlive and "🔵 ALIVE" or "⚪ DEAD"
        local healthText = ""
        
        if isAlive then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                local healthPercent = math.floor((humanoid.Health / humanoid.MaxHealth) * 100)
                healthText = string.format("\n💙 %d%%", healthPercent)
            end
        else
            if esp.timeOfDeath then
                local timeLeft = ESP_SETTINGS.DeadESPTimeout - (tick() - esp.timeOfDeath)
                if timeLeft > 0 then
                    healthText = string.format("\n⏰ %.1fs", timeLeft)
                end
            end
        end
        
        esp.elements.textLabel.Text = string.format(
            "👤 %s\n%s%s\n📐 %d studs",
            player.Name,
            status,
            healthText,
            math.floor(distance)
        )
    else
        esp.elements.textLabel.Text = ""
    end
    
    -- Update tracer
    if localRoot and isAlive and ESP_SETTINGS.ShowTracer then
        esp.elements.attachment0.Parent = localRoot
        esp.elements.attachment1.Parent = humanoidRootPart
        esp.elements.tracer.Enabled = true
        esp.elements.tracer.Parent = localRoot
    else
        esp.elements.tracer.Enabled = false
        esp.elements.attachment0.Parent = nil
        esp.elements.attachment1.Parent = nil
    end
    
    -- Animations only for alive players
    if isAlive and ESP_SETTINGS.ShowBody then
        updatePulseEffect(esp, dt or 0.1)
    else
        -- Static appearance for dead players
        for _, part in ipairs(esp.elements.bodyParts) do
            part.Transparency = ESP_SETTINGS.BodyTransparency + 0.1
        end
    end
end

local function cleanUpESP(player)
    if espCache[player] then
        for _, element in pairs(espCache[player].elements) do
            if type(element) == "table" then
                for _, subElement in pairs(element) do
                    if subElement and subElement.Parent then
                        subElement:Destroy()
                    end
                end
            elseif element and element.Parent then
                element:Destroy()
            end
        end
        espCache[player] = nil
    end
end

function updateAllESP()
    for player, esp in pairs(espCache) do
        if player and player.Parent then
            updateESP(player, esp, 0.1)
        else
            cleanUpESP(player)
        end
    end
end

function enableESP()
    espEnabled = true
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            createESP(player)
        end
    end
end

function disableESP()
    espEnabled = false
    for player, _ in pairs(espCache) do
        cleanUpESP(player)
    end
end

-- Player handlers
local function onPlayerAdded(player)
    if player == LocalPlayer then return end
    
    playerData[player] = {
        connections = {}
    }
    
    if espEnabled then
        createESP(player)
    end
end

local function onPlayerRemoving(player)
    cleanUpESP(player)
    if playerData[player] then
        playerData[player] = nil
    end
end

-- Initialize players
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        onPlayerAdded(player)
    end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Main update loop
local lastUpdate = tick()
spawn(function()
    while true do
        if espEnabled then
            local currentTime = tick()
            local deltaTime = currentTime - lastUpdate
            lastUpdate = currentTime
            
            for player, esp in pairs(espCache) do
                if player and player.Parent then
                    updateESP(player, esp, deltaTime)
                else
                    cleanUpESP(player)
                end
            end
        end
        wait(0.05)
    end
end)

