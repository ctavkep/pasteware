-- Animation variables
local isAnimating = false
local animationTrack = nil
local canPlayAnimation = true
local animation
local character, humanoid

-- Initialize character for animations
local function initializeCharacter()
    character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    humanoid = character:WaitForChild("Humanoid")
    
    animation = Instance.new("Animation")
    animation.AnimationId = ANIM_SETTINGS.CurrentAnimation
end

-- Animation functions with error handling
local function playAnimation()
    if not canPlayAnimation or not ANIM_SETTINGS.IsEnabled then return end
    
    canPlayAnimation = false
    
    if animationTrack then
        animationTrack:Stop()
        animationTrack = nil
    end
    
    -- Always use the default animation
    animation.AnimationId = ANIM_SETTINGS.CurrentAnimation
    
    local success, result = pcall(function()
        animationTrack = humanoid:LoadAnimation(animation)
        animationTrack.Priority = Enum.AnimationPriority.Action
        animationTrack:Play()
        return true
    end)
    
    if not success then
        canPlayAnimation = true
        Rayfield:Notify({
            Title = "Animation Error",
            Content = "Failed to load animation!",
            Duration = 3,
            Image = 4483362458,
        })
        return nil
    end
    
    animationTrack.Stopped:Connect(function()
        canPlayAnimation = true
        animationTrack = nil
    end)
    
    return animationTrack
end

local function stopAnimation()
    if animationTrack then
        animationTrack:Stop()
        animationTrack = nil
    end
    canPlayAnimation = true
end

local function startAnimationLoop()
    if not isAnimating then
        isAnimating = true
        coroutine.wrap(function()
            while isAnimating and character and humanoid and ANIM_SETTINGS.IsEnabled do
                local track = playAnimation()
                if track then
                    track.Ended:Wait()
                else
                    wait(2)
                end
            end
        end)()
    end
end

local function toggleAnimation()
    if not isAnimating then
        startAnimationLoop()
        return true
    else
        isAnimating = false
        stopAnimation()
        return false
    end
end

