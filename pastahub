            -- Функция создания фантома
            local function createGhostModel(pos, sourceCharacter)
                if ghostModel then 
                    ghostModel:Destroy()
                    ghostModel = nil
                end
                
                if not sourceCharacter then
                    sourceCharacter = plrs.LocalPlayer.Character
                    if not sourceCharacter then return nil end
                end
                
                ghostModel = Instance.new("Model")
                ghostModel.Name = rng(8) .. "_Ghost"
                
                for _, child in ipairs(sourceCharacter:GetChildren()) do
                    if child:IsA("BasePart") then
                        local clone = child:Clone()
                        clone.Name = child.Name
                        clone.Material = Enum.Material.Neon
                        clone.Color = Color3.fromRGB(0, 50, 150)
                        clone.Transparency = 0.7
                        clone.CanCollide = false
                        clone.Anchored = true
                        clone.CastShadow = false
                        clone.Size = child.Size
                        clone.CFrame = child.CFrame
                        
                        for _, subChild in ipairs(clone:GetChildren()) do
                            if subChild:IsA("Sound") or subChild:IsA("ParticleEmitter") then
                                subChild:Destroy()
                            end
                        end
                        
                        clone.Parent = ghostModel
                    end
                end
                
                for _, child in ipairs(sourceCharacter:GetChildren()) do
                    if child:IsA("Accessory") then
                        local clone = child:Clone()
                        clone.Name = child.Name
                        
                        local handle = clone:FindFirstChild("Handle")
                        if handle then
                            handle.Material = Enum.Material.Neon
                            handle.Color = Color3.fromRGB(0, 50, 150)
                            handle.Transparency = 0.7
                            handle.CanCollide = false
                            handle.Anchored = true
                        end
                        
                        clone.Parent = ghostModel
                    end
                end
                
                if pos then
                    local root = ghostModel:FindFirstChild("HumanoidRootPart") or ghostModel:FindFirstChild("Torso") or ghostModel:FindFirstChild("UpperTorso")
                    if root then
                        root.CFrame = pos
                    end
                end
                
                ghostModel.Parent = workspace
                
                local light = Instance.new("PointLight")
                light.Brightness = 0.8
                light.Range = 15
                light.Color = Color3.fromRGB(0, 80, 200)
                light.Parent = ghostModel.PrimaryPart or ghostModel:FindFirstChildOfClass("BasePart")
                
                task.spawn(function()
                    while ghostModel and ghostModel.Parent do
                        for _, part in ipairs(ghostModel:GetChildren()) do
                            if part:IsA("BasePart") then
                                for i = 0.6, 0.8, 0.01 do
                                    if not ghostModel or not ghostModel.Parent then break end
                                    part.Transparency = i
                                    task.wait(0.1)
                                end
                                for i = 0.8, 0.6, -0.01 do
                                    if not ghostModel or not ghostModel.Parent then break end
                                    part.Transparency = i
                                    task.wait(0.1)
                                end
                            end
                        end
                        task.wait(0.5)
                    end
                end)
                
                return ghostModel
            end

            local function moveGhost(newpos)
                if ghostModel and ghostModel.Parent then
                    local root = ghostModel:FindFirstChild("HumanoidRootPart") or 
                                 ghostModel:FindFirstChild("Torso") or 
                                 ghostModel:FindFirstChild("UpperTorso") or
                                 ghostModel:FindFirstChildOfClass("BasePart")
                    
                    if root then
                        local offsets = {}
                        for _, part in ipairs(ghostModel:GetChildren()) do
                            if part:IsA("BasePart") and part ~= root then
                                offsets[part] = root.CFrame:ToObjectSpace(part.CFrame)
                            end
                        end
                        
                        root.CFrame = newpos
                        
                        for part, offset in pairs(offsets) do
                            if part and part.Parent then
                                part.CFrame = root.CFrame * offset
                            end
                        end
                    end
                end
            end

